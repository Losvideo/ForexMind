# Copy this file to .env.local and fill in real values. .env.local is gitignored by default.

# Signs the login session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# The single password that gates the whole site (you're the only user).
SITE_PASSWORD=

# OANDA practice (demo) account — register free at https://register.oanda.com (choose "fxTrade Practice", not MT4)
# then generate a personal access token at https://hub.oanda.com/tpa/personal_token
# (or: log into hub.oanda.com → My Account → My Services → Manage API Access)
# Account ID is shown on your account/portfolio view, format ###-###-#######-###.
# Without these, the Live Price Ticker shows "not configured" instead of fake numbers.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=

# Finnhub free tier — register at https://finnhub.io/register for a key (forex news, sentiment, calendar).
# Without this, the Market News module shows "not configured" instead of fake headlines.
FINNHUB_API_KEY=
